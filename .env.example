# --- Wajib ---
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID Telegram kamu (pisahkan dengan koma kalau lebih dari satu).
# Belum tahu? Kosongkan dulu, jalankan bot, kirim pesan apa saja: bot akan membalas Chat ID kamu.
ALLOWED_CHAT_IDS=

# --- Opsional: AI (baca foto struk, kategorisasi cadangan, baca email tagihan) ---
# Tanpa AI, pencatatan teks "makan siang 35rb", anggaran, dan pengingat tetap jalan (aturan lokal).
# Pilihan penyedia: auto (default: anthropic kalau ada API key, selain itu ollama kalau OLLAMA_MODEL
# diisi) | ollama | anthropic | none
LLM_PROVIDER=auto

# (A) Ollama: gratis, jalan di komputermu, data tidak keluar. Jalankan `ollama pull <model>` dulu.
# OLLAMA_MODEL dipakai untuk teks/email. Foto struk butuh model visi di OLLAMA_VISION_MODEL
# (mis. qwen2.5vl:7b); kalau kosong, struk memakai OLLAMA_MODEL (hanya jalan kalau modelnya visi).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# (B) Claude (API berbayar per pemakaian)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Opsional: pemindai email tagihan/langganan (IMAP) ---
# Gmail: aktifkan 2FA lalu buat "App Password". Jangan pakai password utama.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_SCAN_EVERY_HOURS=6
EMAIL_LOOKBACK_DAYS=45

# --- Dashboard web (hanya-baca, hanya laptop ini) ---
# Buka lewat tautan dari perintah /dashboard di Telegram. 0 = matikan.
DASHBOARD_PORT=8765
# Kosong = token acak dibuat sekali dan disimpan di data/dashboard_token.
DASHBOARD_TOKEN=

# --- Lain-lain ---
DB_PATH=data/keuangan.db
TIMEZONE=Asia/Jakarta
REMINDER_DAYS_AHEAD=3
