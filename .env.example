# --- Wajib ---
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID admin/pemilik bot (pisahkan dengan koma). Admin selalu aktif dan boleh membuat kode
# undangan (/undang), melihat daftar pengguna (/pengguna), dan memblokir.
# Belum tahu? Kosongkan dulu, jalankan bot, kirim pesan apa saja: bot akan membalas Chat ID kamu.
# (Nama lama ALLOWED_CHAT_IDS masih dibaca bila ADMIN_CHAT_IDS kosong.)
ADMIN_CHAT_IDS=

# --- AI (baca foto struk, kategorisasi cadangan, /tanya) ---
# Tanpa AI, pencatatan teks "makan siang 35rb", anggaran, dashboard, dan pengingat tetap jalan.
# Pilihan penyedia: auto (anthropic kalau ada API key, selain itu ollama kalau OLLAMA_MODEL diisi)
#                   | ollama | anthropic | none
LLM_PROVIDER=auto

# (A) Ollama: jalan di server sendiri, data tidak dikirim ke pihak ketiga.
# Jalankan `ollama pull <model>` dulu. OLLAMA_MODEL untuk teks/pertanyaan; struk butuh model visi.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# (B) Claude (API berbayar per pemakaian)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Kuota & antrean AI untuk pengguna (admin bebas kuota)
AI_DAILY_LIMIT=30            # panggilan AI (struk, /tanya) per pengguna per hari
AI_MAX_CONCURRENT=           # kosong = 1 untuk Ollama (diproses satu per satu), 4 untuk Claude
AI_QUEUE_WAIT_SECONDS=90     # lama menunggu giliran AI sebelum "AI sedang sibuk"

# --- Pemindai email tagihan (IMAP): HANYA untuk admin (satu kotak surat milik pemilik) ---
# Gmail: aktifkan 2FA lalu buat "App Password". Jangan pakai password utama.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_SCAN_EVERY_HOURS=6
EMAIL_LOOKBACK_DAYS=45

# --- Dashboard web (baca-saja, login per pengguna lewat tautan dari /dashboard) ---
# 0 = matikan. Server hanya mendengarkan alamat lokal; untuk akses publik pasang proxy TLS
# (Caddy/nginx) di depannya, lalu isi DASHBOARD_PUBLIC_URL. Lihat docs/DEPLOY.md.
DASHBOARD_PORT=8765
DASHBOARD_PUBLIC_URL=        # mis. https://uang.contoh.id (kosong = http://localhost:PORT)
DASHBOARD_TRUST_PROXY=       # isi "true" HANYA bila berada di balik proxy milikmu sendiri
DASHBOARD_SESSION_DAYS=7

# --- Data & cadangan ---
DB_PATH=data/keuangan.db
BACKUP_DIR=data/backups      # cadangan otomatis tiap 03:30
BACKUP_KEEP=14               # simpan 14 cadangan terbaru

# --- Lain-lain ---
TIMEZONE=Asia/Jakarta
REMINDER_DAYS_AHEAD=3
